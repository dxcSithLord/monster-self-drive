{
  "$schema": "./config.schema.json",
  "security": {
    "webBindAddress": "127.0.0.1",
    "webPort": 8080
  },
  "power": {
    "voltageIn": 12.0,
    "voltageOut": 11.4,
    "voltageInComment": "Total battery voltage (1.2V * 10 cells)",
    "voltageOutComment": "Maximum motor voltage (12.0V * 0.95 for RPi headroom)"
  },
  "camera": {
    "width": 640,
    "height": 480,
    "frameRate": 30,
    "flippedImage": true,
    "jpegQuality": 80,
    "displayRate": 10
  },
  "processing": {
    "scaledWidth": 160,
    "scaledHeight": 120,
    "processingThreads": 4,
    "minHuntColour": [80, 0, 0],
    "maxHuntColour": [255, 100, 100],
    "erodeSize": 5,
    "targetY1Ratio": 0.9,
    "targetY2Ratio": 0.6
  },
  "detection": {
    "enabled": true,
    "backend": "auto",
    "backendComment": "Detection backend: 'coral' (TPU), 'cpu' (TFLite), 'opencv' (tracker only), 'color', 'auto' (best available)",
    "modelPath": "models/ssd_mobilenet_v2_coco_quant_postprocess_edgetpu.tflite",
    "modelPathComment": "Path to TFLite model (relative to project root)",
    "labelsPath": "models/coco_labels.txt",
    "confidenceThreshold": 0.5,
    "confidenceThresholdComment": "Minimum confidence score (0.0-1.0) for detection",
    "targetClasses": ["person"],
    "targetClassesComment": "COCO classes to track: person, dog, cat, car, bicycle, etc.",
    "maxDetections": 10,
    "detectionInterval": 5,
    "detectionIntervalComment": "Run full detection every N frames (tracker maintains position between)",
    "inputWidth": 300,
    "inputHeight": 300,
    "inputWidthComment": "Model input dimensions (MobileNet SSD uses 300x300)"
  },
  "tracking": {
    "enabled": true,
    "method": "KCF",
    "methodComment": "OpenCV tracker: 'CSRT' (accurate), 'KCF' (fast), 'MOSSE' (fastest)",
    "redetectOnLoss": true,
    "redetectOnLossComment": "Run full detection when tracker loses object",
    "maxTrackingLoss": 30,
    "maxTrackingLossComment": "Frames before declaring object lost",
    "iouThreshold": 0.3,
    "iouThresholdComment": "Minimum IoU to match detection with tracked object"
  },
  "following": {
    "enabled": false,
    "targetDistance": 1.5,
    "targetDistanceComment": "Desired following distance in meters",
    "minDistance": 0.5,
    "maxDistance": 3.0,
    "distanceP": 0.5,
    "distanceI": 0.1,
    "distanceD": 0.2,
    "steeringP": 0.8,
    "steeringI": 0.05,
    "steeringD": 0.3,
    "maxSpeed": 0.8,
    "maxSpeedComment": "Maximum following speed (0.0-1.0)"
  },
  "control": {
    "motorSmoothing": 5,
    "positionP": 1.0,
    "positionI": 0.0,
    "positionD": 0.4,
    "changeP": 1.0,
    "changeI": 0.0,
    "changeD": 0.4,
    "clipI": 100
  },
  "drive": {
    "steeringGain": 1.0,
    "steeringClip": 1.0,
    "steeringOffset": 0.0
  },
  "debug": {
    "showFps": true,
    "testMode": true,
    "showImages": true,
    "overlayOriginal": true,
    "showPerSecond": 1,
    "scaleFinalImage": 1.0,
    "targetLineColour": [0, 255, 255],
    "targetPointsColour": [255, 255, 0],
    "targetPointSize": 3
  },
  "safety": {
    "batteryStopVoltage": 10.5,
    "batteryWarningVoltage": 11.0,
    "watchdogTimeoutSeconds": 1.0,
    "emergencyStopEnabled": true
  },
  "paths": {
    "photoDirectory": "~/monster-photos"
  },
  "websocket": {
    "enabled": true,
    "pingTimeout": 10,
    "pingInterval": 5,
    "telemetryRate": 10,
    "telemetryRateComment": "Telemetry updates per second (Hz)"
  }
}
